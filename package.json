{
  "name": "arxatec-scrapping",
  "version": "1.0.0",
  "description": "Scraper SPIJ (MINJUS Perú) — puerto TypeScript del scraper Python.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/services/sources/index.test.ts src/modules/spij/utils/classifier/index.test.ts src/modules/elperuano/utils/csv/index.test.ts",
    "cli": "tsx src/cli.ts",
    "spij": "tsx src/cli.ts spij",
    "pj": "tsx src/cli.ts pj",
    "tc": "tsx src/cli.ts tc",
    "elperuano": "tsx src/cli.ts elperuano",
    "tfiscal": "tsx src/cli.ts tfiscal",
    "ingest": "tsx src/cli.ts spij",
    "entidades": "tsx src/cli.ts entidades",
    "all": "tsx src/cli.ts all",
    "status": "tsx src/cli.ts status"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "dotenv": "^16.4.5",
    "env-var": "^7.5.0",
    "puppeteer": "^23.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "tesseract.js"
    ]
  }
}
