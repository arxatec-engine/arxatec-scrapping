INGEST_BASE_URL=https://api.tu-servidor.com
INGEST_TOKEN=eyJhbGciOi...

GROQ_API_KEY=gsk_...
LLM_MODEL=llama-3.1-8b-instant

# --- Ingesta local (INGEST_MODE=local) ---------------------------------------
# Con `local`, el módulo escribe directo en Vertex + Qdrant + PostgreSQL + S3 en
# vez de hacer POST al assistant. Son las MISMAS variables que usa el assistant:
# cópialas de su .env. Por defecto INGEST_MODE=remote y nada cambia.
INGEST_MODE=remote
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://usuario:clave@localhost:5432/arxatec
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/ruta/al/service-account.json
# Techo de embeddings en vuelo POR PROCESO. Con los 8 módulos a la vez, el techo
# efectivo contra Vertex es 8 × este valor: mira la cuota antes de subirlo.
EMBEDDING_MAX_CONCURRENCY=8
EMBEDDING_MAX_RETRIES=4
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=
