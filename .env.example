# ─────────────────────────────────────────────────────────────────────────────
# arxatec-scrapping — plantilla del .env
#
# SOLO variables que este repo lee. Si copias el .env del assistant tal cual,
# arrastras diez que aquí no se usan (JWT_*, ADMIN_SECRET, CORS_*, ENVIRONMENT,
# LOG_LEVEL, ARXATEC_SERVICE_URL, ASSISTANT_*) y ninguna de ellas hace nada.
# ─────────────────────────────────────────────────────────────────────────────

# ── Modo de ingesta ──────────────────────────────────────────────────────────
# local  = el módulo escribe él mismo en Vertex + Qdrant + PostgreSQL + S3
# remote = POST al assistant (comportamiento histórico)
INGEST_MODE=remote

# Solo para INGEST_MODE=remote
INGEST_BASE_URL=http://127.0.0.1:8000
# = ASSISTANT_SYNC_TOKEN del assistant. En su .env va entre comillas: léelo con
# dotenv, nunca con `cut`.
INGEST_TOKEN=

# ── Ingesta local: Qdrant y PostgreSQL ───────────────────────────────────────
# Las mismas que usa el assistant: cópialas de su .env.
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://usuario:clave@localhost:5432/arxatec

# ── Ingesta local: embeddings ────────────────────────────────────────────────
# Modelo: "gemini-embedding-001" de Gemini a través de Vertex AI (1024 dims,
# normalizado L2). No es AI Studio: la autenticación va por cuenta de servicio.
#
# ⚠️ La ruta debe existir. Un typo aquí no da un error claro: Vertex falla al
# autenticar y la ingesta muere documento a documento.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/al/.gcloud_key.json

# Techo de embeddings en vuelo POR PROCESO. Con los 8 módulos corriendo a la vez
# el techo efectivo contra Vertex es 8 × este valor: mira la cuota del proyecto
# antes de subirlo.
EMBEDDING_MAX_CONCURRENCY=8
EMBEDDING_MAX_RETRIES=4

# Saltar el re-embedding cuando el documento ya está indexado y no ha cambiado.
# `false` reindexa siempre: útil mientras se comprueba que la ingesta embebe.
INGEST_SKIP_UNCHANGED=true

# ── Ingesta local: S3 (sin bucket, no se sube el original) ───────────────────
# OJO: los nombres de las claves NO son los estándar del SDK de AWS; se pasan
# explícitamente al cliente por eso mismo.
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=
AWS_KEY_ACCESS=
AWS_KEY_ACCESS_SECRET=

# ── Clasificador de área legal (Groq) ────────────────────────────────────────
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ── Variables por módulo (opcionales; el resto tiene default en el código) ───
PJ_ROOT=
# SPIJ trae cuenta pública por defecto en el código (spijext): estas dos son
# opcionales, solo para usar una cuenta propia.
SPIJ_USER=
SPIJ_CLAVE=
