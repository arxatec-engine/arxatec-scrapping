# Timer de la campaña: relanza la pasada cada 6 horas contadas desde que la
# anterior TERMINÓ (OnUnitInactiveSec), así dos pasadas nunca se solapan.
# Persistent=true recupera la pasada perdida si la VM estuvo apagada.
[Unit]
Description=Relanza la campaña de scraping Arxatec cada 6h

[Timer]
OnBootSec=5min
OnUnitInactiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
